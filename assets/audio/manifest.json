[
 {
  "page": "P1",
  "id": "p1s0",
  "text": "メンタエクセル式、Microsoft Copilot入門、完全版。",
  "file": "p1s0.mp3",
  "duration": 5.042
 },
 {
  "page": "P1",
  "id": "p1s1",
  "text": "音声で聴ける電子書籍、はじまります。",
  "file": "p1s1.mp3",
  "duration": 2.769
 },
 {
  "page": "P2",
  "id": "p2s0",
  "text": "はい、皆さんこんにちは。",
  "file": "p2s0.mp3",
  "duration": 1.698
 },
 {
  "page": "P2",
  "id": "p2s1",
  "text": "メンタエクセルのTAKUYAです。",
  "file": "p2s1.mp3",
  "duration": 1.541
 },
 {
  "page": "P2",
  "id": "p2s2",
  "text": "今回はですね、Microsoft Copilot入門というテーマで、音声付きの電子書籍を作ってみました。",
  "file": "p2s2.mp3",
  "duration": 7.366
 },
 {
  "page": "P2",
  "id": "p2s3",
  "text": "この本、僕の声で読み上げが自動で進んで、今読んでいるところに蛍光ペンでマーカーが引かれて、ページも勝手にめくれていくんですよ。",
  "file": "p2s3.mp3",
  "duration": 8.986
 },
 {
  "page": "P2",
  "id": "p2s4",
  "text": "読み上げの速度は下のバーで変えられますし、図解や画面はクリックすると大きく表示できます。",
  "file": "p2s4.mp3",
  "duration": 6.713
 },
 {
  "page": "P2",
  "id": "p2s5",
  "text": "なので皆さんは、聴きながら眺めているだけでOKです。",
  "file": "p2s5.mp3",
  "duration": 3.448
 },
 {
  "page": "P2",
  "id": "p2s6",
  "text": "それではですね、一緒に学んでいきましょう。",
  "file": "p2s6.mp3",
  "duration": 2.534
 },
 {
  "page": "P3",
  "id": "p3s0",
  "text": "で、先にこの本の全体像をお伝えしておきますね。",
  "file": "p3s0.mp3",
  "duration": 3.605
 },
 {
  "page": "P3",
  "id": "p3s1",
  "text": "前半では、Copilotの正体と、皆さんの会社で追加費用なしでどこまで使えるのかという話をしていきます。",
  "file": "p3s1.mp3",
  "duration": 7.811
 },
 {
  "page": "P3",
  "id": "p3s2",
  "text": "真ん中では、ExcelやWord、Outlookでの実演を、実際の画面と一緒に見ていきます。",
  "file": "p3s2.mp3",
  "duration": 6.426
 },
 {
  "page": "P3",
  "id": "p3s3",
  "text": "で、後半は、上手なお願いの仕方と、職種別の活用例、あとは世界の研究データですね。",
  "file": "p3s3.mp3",
  "duration": 7.811
 },
 {
  "page": "P3",
  "id": "p3s4",
  "text": "読み終わる頃には、明日から会社で使えるレベルになっているんじゃないかなと思います。",
  "file": "p3s4.mp3",
  "duration": 5.068
 },
 {
  "page": "P4",
  "id": "p4s0",
  "text": "で、まずCopilotって何なのかという話なんですけれども。",
  "file": "p4s0.mp3",
  "duration": 4.232
 },
 {
  "page": "P4",
  "id": "p4s1",
  "text": "皆さん、ChatGPTは聞いたことありますよね。",
  "file": "p4s1.mp3",
  "duration": 3.317
 },
 {
  "page": "P4",
  "id": "p4s2",
  "text": "Copilotっていうのは、簡単に言うとマイクロソフト公式のAIアシスタントですね。",
  "file": "p4s2.mp3",
  "duration": 5.407
 },
 {
  "page": "P4",
  "id": "p4s3",
  "text": "ExcelやWordと同じマイクロソフトの世界の中で、安全に使えるように作られているんですよ。",
  "file": "p4s3.mp3",
  "duration": 6.322
 },
 {
  "page": "P4",
  "id": "p4s4",
  "text": "イメージとしては、会社公認のAIの相棒という感じですね。",
  "file": "p4s4.mp3",
  "duration": 4.049
 },
 {
  "page": "P5",
  "id": "p5s0",
  "text": "で、このCopilot、中身は何なのかというと、実はChatGPTで有名なGPTとかClaudeとか、世界最先端のAIがそのまま動いているんですよ。",
  "file": "p5s0.mp3",
  "duration": 10.475
 },
 {
  "page": "P5",
  "id": "p5s1",
  "text": "つまり、性能は本家のAIと同じレベルで、そこにマイクロソフトの安全装置がついている。",
  "file": "p5s1.mp3",
  "duration": 7.21
 },
 {
  "page": "P5",
  "id": "p5s2",
  "text": "どういうことかというと、AIの頭脳はそのままで、会社で使える鎧を着せたのがCopilotということですね。",
  "file": "p5s2.mp3",
  "duration": 7.157
 },
 {
  "page": "P6",
  "id": "p6s0",
  "text": "で、ここが結構大事なポイントなんですけれども、Copilotには大きく3つの階層があるんですよ。",
  "file": "p6s0.mp3",
  "duration": 6.844
 },
 {
  "page": "P6",
  "id": "p6s1",
  "text": "1つ目が、誰でも無料で使えるCopilot。",
  "file": "p6s1.mp3",
  "duration": 3.187
 },
 {
  "page": "P6",
  "id": "p6s2",
  "text": "2つ目が、Microsoft 365の契約についてくるCopilot Chat。",
  "file": "p6s2.mp3",
  "duration": 5.407
 },
 {
  "page": "P6",
  "id": "p6s3",
  "text": "で、3つ目が、有料版のMicrosoft 365 Copilot、いわゆるPremiumですね。",
  "file": "p6s3.mp3",
  "duration": 6.243
 },
 {
  "page": "P6",
  "id": "p6s4",
  "text": "上に行くほど、できることが増えていきます。",
  "file": "p6s4.mp3",
  "duration": 2.482
 },
 {
  "page": "P6",
  "id": "p6s5",
  "text": "この3層構造、ざっくりでいいので覚えておいていただけたらなと思います。",
  "file": "p6s5.mp3",
  "duration": 4.336
 },
 {
  "page": "P7",
  "id": "p7s0",
  "text": "で、ここからが本題なんですけれども。",
  "file": "p7s0.mp3",
  "duration": 2.847
 },
 {
  "page": "P7",
  "id": "p7s1",
  "text": "皆さんの会社がMicrosoft 365のBusinessプラン、つまりBasicとかStandardとかPremiumを契約していたら、Copilot Chatは追加費用なしでもう使えるんですよ。",
  "file": "p7s1.mp3",
  "duration": 10.318
 },
 {
  "page": "P7",
  "id": "p7s2",
  "text": "E3やE5といった大企業向けのプランでも同じですね。",
  "file": "p7s2.mp3",
  "duration": 3.814
 },
 {
  "page": "P7",
  "id": "p7s3",
  "text": "会社でExcelやOutlookを使っている方なら、ほぼ間違いなく対象です。",
  "file": "p7s3.mp3",
  "duration": 5.277
 },
 {
  "page": "P7",
  "id": "p7s4",
  "text": "知らないだけだと、めちゃくちゃもったいないですよということですね。",
  "file": "p7s4.mp3",
  "duration": 2.978
 },
 {
  "page": "P8",
  "id": "p8s0",
  "text": "じゃあ有料版はいくらなのかというと、大体月々4,500円ぐらい。",
  "file": "p8s0.mp3",
  "duration": 4.754
 },
 {
  "page": "P8",
  "id": "p8s1",
  "text": "中小企業向けだと、月3,000円前後のプランもあります。",
  "file": "p8s1.mp3",
  "duration": 3.683
 },
 {
  "page": "P8",
  "id": "p8s2",
  "text": "高いなと感じた方に、ちょっと僕の考えをお伝えしますね。",
  "file": "p8s2.mp3",
  "duration": 3.97
 },
 {
  "page": "P8",
  "id": "p8s3",
  "text": "AIへの課金って、道具を買うんじゃなくて、時間を買ってる感覚なんですよ。",
  "file": "p8s3.mp3",
  "duration": 4.624
 },
 {
  "page": "P8",
  "id": "p8s4",
  "text": "1時間かかってた資料が10分で終わるなら、毎回50分戻ってくる。",
  "file": "p8s4.mp3",
  "duration": 4.754
 },
 {
  "page": "P8",
  "id": "p8s5",
  "text": "月なら十数時間ですよ。",
  "file": "p8s5.mp3",
  "duration": 2.011
 },
 {
  "page": "P8",
  "id": "p8s6",
  "text": "なのでまずは追加費用なしの範囲で使い倒して、物足りなくなったら、時間を買う投資として有料版を検討する。",
  "file": "p8s6.mp3",
  "duration": 8.202
 },
 {
  "page": "P8",
  "id": "p8s7",
  "text": "この順番でOKです。",
  "file": "p8s7.mp3",
  "duration": 1.541
 },
 {
  "page": "P9",
  "id": "p9s0",
  "text": "それではですね、開き方を見ていきましょう。",
  "file": "p9s0.mp3",
  "duration": 2.847
 },
 {
  "page": "P9",
  "id": "p9s1",
  "text": "ブラウザで、m365.cloud.microsoft にアクセスすると、こちらのようなチャット画面が出てきます。",
  "file": "p9s1.mp3",
  "duration": 8.15
 },
 {
  "page": "P9",
  "id": "p9s2",
  "text": "会社のアカウントでサインインするだけで、もう使える状態ですね。",
  "file": "p9s2.mp3",
  "duration": 3.97
 },
 {
  "page": "P9",
  "id": "p9s3",
  "text": "この画面が出たら、準備は完了です。",
  "file": "p9s3.mp3",
  "duration": 2.482
 },
 {
  "page": "P10",
  "id": "p10s0",
  "text": "で、有料版を使っている方は、ExcelやWordの画面からも開けます。",
  "file": "p10s0.mp3",
  "duration": 4.101
 },
 {
  "page": "P10",
  "id": "p10s1",
  "text": "画面の右下に丸いCopilotのマークがあって、そこを押すと画面の右側にチャットが開くんですね。",
  "file": "p10s1.mp3",
  "duration": 5.825
 },
 {
  "page": "P10",
  "id": "p10s2",
  "text": "追加費用なしの範囲で使う場合は、さっきのブラウザの画面と、Outlookから使うのが基本になります。",
  "file": "p10s2.mp3",
  "duration": 6.739
 },
 {
  "page": "P10",
  "id": "p10s3",
  "text": "作業しながら、横で相談できるというのがポイントですね。",
  "file": "p10s3.mp3",
  "duration": 3.97
 },
 {
  "page": "P11",
  "id": "p11s0",
  "text": "会社の情報をAIに入れて大丈夫なの、って心配になった方もいると思うんですけれども、ご安心ください。",
  "file": "p11s0.mp3",
  "duration": 6.295
 },
 {
  "page": "P11",
  "id": "p11s1",
  "text": "マイクロソフトが公式に明言していて、Copilotに入力した内容が、AIの学習に使われることはありません。",
  "file": "p11s1.mp3",
  "duration": 7.131
 },
 {
  "page": "P11",
  "id": "p11s2",
  "text": "データは会社のメールやファイルと同じ契約の中で保護されて、自分に閲覧権限のない情報には、Copilotもアクセスできない仕組みになっているんですね。",
  "file": "p11s2.mp3",
  "duration": 10.057
 },
 {
  "page": "P11",
  "id": "p11s3",
  "text": "仕事で使う前提で設計されているということです。",
  "file": "p11s3.mp3",
  "duration": 3.317
 },
 {
  "page": "P12",
  "id": "p12s0",
  "text": "で、無料のチャットAIと何が違うのかというと、一番の違いは契約上の保護なんですよ。",
  "file": "p12s0.mp3",
  "duration": 5.59
 },
 {
  "page": "P12",
  "id": "p12s1",
  "text": "無料のAIは、入力内容が学習に使われる設定になっていることがあるんですね。",
  "file": "p12s1.mp3",
  "duration": 5.59
 },
 {
  "page": "P12",
  "id": "p12s2",
  "text": "でもCopilotは、会社のアカウントで入れば、エンタープライズデータ保護というのが自動で有効になります。",
  "file": "p12s2.mp3",
  "duration": 7.21
 },
 {
  "page": "P12",
  "id": "p12s3",
  "text": "つまり、会社の情報を扱っていいAIかどうか、ここで線が引かれるということですね。",
  "file": "p12s3.mp3",
  "duration": 5.721
 },
 {
  "page": "P13",
  "id": "p13s0",
  "text": "それでは、実演に入っていきましょう。",
  "file": "p13s0.mp3",
  "duration": 2.429
 },
 {
  "page": "P13",
  "id": "p13s1",
  "text": "まずは一番簡単な使い方、普通に質問してみるところからですね。",
  "file": "p13s1.mp3",
  "duration": 4.153
 },
 {
  "page": "P13",
  "id": "p13s2",
  "text": "こちらの画面では、実際に、VLOOKUPとXLOOKUPの違いを表にして教えて、とお願いしてみました。",
  "file": "p13s2.mp3",
  "duration": 7.628
 },
 {
  "page": "P13",
  "id": "p13s3",
  "text": "そうすると、このように一瞬で、わかりやすい表で答えが返ってくるわけですよ。",
  "file": "p13s3.mp3",
  "duration": 5.407
 },
 {
  "page": "P13",
  "id": "p13s4",
  "text": "ChatGPTと同じ感覚で使っていただいてOKです。",
  "file": "p13s4.mp3",
  "duration": 3.683
 },
 {
  "page": "P14",
  "id": "p14s0",
  "text": "次は、Excelとの組み合わせですね。",
  "file": "p14s0.mp3",
  "duration": 2.482
 },
 {
  "page": "P14",
  "id": "p14s1",
  "text": "売上表を開いて、この表を分析して、商品ごとの傾向を教えて、とお願いしてみました。",
  "file": "p14s1.mp3",
  "duration": 8.385
 },
 {
  "page": "P14",
  "id": "p14s2",
  "text": "そうすると、ご覧のとおり、表を読み取って、分析シートを丸ごと自動で作ってくれたんですよ。",
  "file": "p14s2.mp3",
  "duration": 6.478
 },
 {
  "page": "P14",
  "id": "p14s3",
  "text": "合計や増加率の計算から、注目ポイントの解説まで入っています。",
  "file": "p14s3.mp3",
  "duration": 4.859
 },
 {
  "page": "P14",
  "id": "p14s4",
  "text": "正直、これが一番感動するところじゃないかなと思います。",
  "file": "p14s4.mp3",
  "duration": 3.5
 },
 {
  "page": "P15",
  "id": "p15s0",
  "text": "で、今の画面で何が起きたのか、解説しますね。",
  "file": "p15s0.mp3",
  "duration": 3.97
 },
 {
  "page": "P15",
  "id": "p15s1",
  "text": "Copilotは表の中身を読み取って、まず全体の合計と増加率を計算しました。",
  "file": "p15s1.mp3",
  "duration": 5.695
 },
 {
  "page": "P15",
  "id": "p15s2",
  "text": "で、伸びている商品と落ちている商品を見つけて、注目ポイントとして文章でまとめてくれたわけです。",
  "file": "p15s2.mp3",
  "duration": 6.557
 },
 {
  "page": "P15",
  "id": "p15s3",
  "text": "ここまで全部、日本語で一言お願いしただけです。",
  "file": "p15s3.mp3",
  "duration": 3.135
 },
 {
  "page": "P15",
  "id": "p15s4",
  "text": "関数もピボットテーブルも、僕らは一切触っていないんですね。",
  "file": "p15s4.mp3",
  "duration": 4.441
 },
 {
  "page": "P16",
  "id": "p16s0",
  "text": "Excelでできることは、他にもたくさんあります。",
  "file": "p16s0.mp3",
  "duration": 2.9
 },
 {
  "page": "P16",
  "id": "p16s1",
  "text": "例えば、利益率を計算する列を追加して、と言えば数式ごと作ってくれますし、外れ値はある、と聞けば異常値を見つけてくれる。",
  "file": "p16s1.mp3",
  "duration": 9.665
 },
 {
  "page": "P16",
  "id": "p16s2",
  "text": "あとは、グラフやピボットテーブルの作成、条件付き書式の設定なんかも、全部お願いできます。",
  "file": "p16s2.mp3",
  "duration": 6.139
 },
 {
  "page": "P16",
  "id": "p16s3",
  "text": "数式がわからなくても、日本語で言えばいいんです。",
  "file": "p16s3.mp3",
  "duration": 2.612
 },
 {
  "page": "P16",
  "id": "p16s4",
  "text": "Excelの苦手意識がなくなる感覚、ぜひ体感していただきたいです。",
  "file": "p16s4.mp3",
  "duration": 4.754
 },
 {
  "page": "P17",
  "id": "p17s0",
  "text": "で、Wordでも同じことができます。",
  "file": "p17s0.mp3",
  "duration": 2.482
 },
 {
  "page": "P17",
  "id": "p17s1",
  "text": "例えば、AI活用勉強会の案内文を書いて、とお願いすると、このように下書きを一気に作ってくれるわけですよ。",
  "file": "p17s1.mp3",
  "duration": 8.699
 },
 {
  "page": "P17",
  "id": "p17s2",
  "text": "ゼロから書き始めるのって、結構しんどいじゃないですか。",
  "file": "p17s2.mp3",
  "duration": 3.553
 },
 {
  "page": "P17",
  "id": "p17s3",
  "text": "その最初の一歩をCopilotに任せて、僕らは仕上げだけやると。",
  "file": "p17s3.mp3",
  "duration": 4.467
 },
 {
  "page": "P17",
  "id": "p17s4",
  "text": "これだけで文書作成は、めちゃくちゃ楽になりますね。",
  "file": "p17s4.mp3",
  "duration": 3.37
 },
 {
  "page": "P18",
  "id": "p18s0",
  "text": "Wordでは他にも、書き終わった文章を選んで、もっと丁寧なトーンに書き換えて、とか、この文書を要約して、みたいなこともできます。",
  "file": "p18s0.mp3",
  "duration": 9.064
 },
 {
  "page": "P18",
  "id": "p18s1",
  "text": "で、意外と知られていないのが、有料版で使える、スラッシュを打ってファイル名を指定すると、社内の資料を参照しながら下書きしてくれる機能ですね。",
  "file": "p18s1.mp3",
  "duration": 10.423
 },
 {
  "page": "P18",
  "id": "p18s2",
  "text": "過去の提案書を下敷きに、新しい提案書を作る、なんてこともできちゃうわけです。",
  "file": "p18s2.mp3",
  "duration": 4.806
 },
 {
  "page": "P19",
  "id": "p19s0",
  "text": "あとは、Outlook、メールですね。",
  "file": "p19s0.mp3",
  "duration": 3.265
 },
 {
  "page": "P19",
  "id": "p19s1",
  "text": "こちらの画面では、来週の打ち合わせの日程変更をお願いする、丁寧なメールを書いて、とお願いしました。",
  "file": "p19s1.mp3",
  "duration": 7.314
 },
 {
  "page": "P19",
  "id": "p19s2",
  "text": "そうすると、件名から本文まで、ちゃんと敬語のメールを一瞬で作ってくれるんですよ。",
  "file": "p19s2.mp3",
  "duration": 6.139
 },
 {
  "page": "P19",
  "id": "p19s3",
  "text": "候補日の枠まで用意してくれていますね。",
  "file": "p19s3.mp3",
  "duration": 2.246
 },
 {
  "page": "P19",
  "id": "p19s4",
  "text": "あとは自分で日付を入れて送るだけ、という感じです。",
  "file": "p19s4.mp3",
  "duration": 2.9
 },
 {
  "page": "P20",
  "id": "p20s0",
  "text": "で、メールで一番時間を取られるのって、長いやり取りの把握じゃないですか。",
  "file": "p20s0.mp3",
  "duration": 4.937
 },
 {
  "page": "P20",
  "id": "p20s1",
  "text": "Copilotなら、何十往復したスレッドでも、要約して、の一言で要点だけ出してくれます。",
  "file": "p20s1.mp3",
  "duration": 6.896
 },
 {
  "page": "P20",
  "id": "p20s2",
  "text": "さらに、有料版には、書いた下書きのトーンや伝わりやすさをコーチングしてくれる機能まであるんですね。",
  "file": "p20s2.mp3",
  "duration": 6.243
 },
 {
  "page": "P20",
  "id": "p20s3",
  "text": "毎日のメール処理の時間が、がっつり変わってきますよということです。",
  "file": "p20s3.mp3",
  "duration": 4.101
 },
 {
  "page": "P21",
  "id": "p21s0",
  "text": "次は、PowerPointですね。",
  "file": "p21s0.mp3",
  "duration": 2.011
 },
 {
  "page": "P21",
  "id": "p21s1",
  "text": "こちらでは、仕事が速い人の時間管理術というテーマで、5枚のプレゼンテーションを作成して、とお願いしてみました。",
  "file": "p21s1.mp3",
  "duration": 7.732
 },
 {
  "page": "P21",
  "id": "p21s2",
  "text": "そうすると、デザインの雰囲気を選ぶだけで、スライドを丸ごと作ってくれるんですよ。",
  "file": "p21s2.mp3",
  "duration": 5.721
 },
 {
  "page": "P21",
  "id": "p21s3",
  "text": "構成から見出し、本文まで自動です。",
  "file": "p21s3.mp3",
  "duration": 2.847
 },
 {
  "page": "P21",
  "id": "p21s4",
  "text": "たたき台が数分でできるので、資料作成の景色が変わりますね。",
  "file": "p21s4.mp3",
  "duration": 4.153
 },
 {
  "page": "P22",
  "id": "p22s0",
  "text": "PowerPointでは他にも、Wordの企画書を渡して、そのままスライド化したり、この内容に合う画像を追加して、と画像を生成させたりもできます。",
  "file": "p22s0.mp3",
  "duration": 10.736
 },
 {
  "page": "P22",
  "id": "p22s1",
  "text": "コツはですね、元のWord文書を見出しで構造化しておくこと。",
  "file": "p22s1.mp3",
  "duration": 4.702
 },
 {
  "page": "P22",
  "id": "p22s2",
  "text": "これだけで仕上がりが全然変わってきます。",
  "file": "p22s2.mp3",
  "duration": 2.429
 },
 {
  "page": "P22",
  "id": "p22s3",
  "text": "ゼロから作らないっていうのが、新しい常識になるという感じですね。",
  "file": "p22s3.mp3",
  "duration": 4.754
 },
 {
  "page": "P23",
  "id": "p23s0",
  "text": "で、会議のTeamsですね。",
  "file": "p23s0.mp3",
  "duration": 2.717
 },
 {
  "page": "P23",
  "id": "p23s1",
  "text": "Copilotを入れると、会議の要約、誰が何を言ったか、決まったこと、宿題の一覧まで、自動でまとめてくれるんですよ。",
  "file": "p23s1.mp3",
  "duration": 8.516
 },
 {
  "page": "P23",
  "id": "p23s2",
  "text": "遅れて参加しても、ここまでの流れを教えて、と聞けば追いつけます。",
  "file": "p23s2.mp3",
  "duration": 4.571
 },
 {
  "page": "P23",
  "id": "p23s3",
  "text": "マイクロソフトの調査だと、欠席した会議のキャッチアップが約4倍速くなったというデータもあるんですね。",
  "file": "p23s3.mp3",
  "duration": 7.027
 },
 {
  "page": "P23",
  "id": "p23s4",
  "text": "議事録係が、もういらなくなっちゃうわけです。",
  "file": "p23s4.mp3",
  "duration": 3.213
 },
 {
  "page": "P24",
  "id": "p24s0",
  "text": "で、実はここまでのアプリ別の話を、ぜんぶ一つの窓口でできるのが、Copilotチャットなんですね。",
  "file": "p24s0.mp3",
  "duration": 7.732
 },
 {
  "page": "P24",
  "id": "p24s1",
  "text": "有料版だと、会社のメール、ファイル、会議とつながるので、例えば、先週の会議の決定事項をまとめて、とか、この案件に詳しい人は誰、みたいな聞き方ができちゃう。",
  "file": "p24s1.mp3",
  "duration": 12.695
 },
 {
  "page": "P24",
  "id": "p24s2",
  "text": "アプリを行き来しなくても、聞けば出てくる。",
  "file": "p24s2.mp3",
  "duration": 2.795
 },
 {
  "page": "P24",
  "id": "p24s3",
  "text": "これが本当の実力ということですね。",
  "file": "p24s3.mp3",
  "duration": 2.377
 },
 {
  "page": "P25",
  "id": "p25s0",
  "text": "ここからは、上手なお願いの仕方ですね。",
  "file": "p25s0.mp3",
  "duration": 3.317
 },
 {
  "page": "P25",
  "id": "p25s1",
  "text": "マイクロソフトが公式に出しているコツが、4つの要素なんですよ。",
  "file": "p25s1.mp3",
  "duration": 4.232
 },
 {
  "page": "P25",
  "id": "p25s2",
  "text": "1つ目、目標。",
  "file": "p25s2.mp3",
  "duration": 1.881
 },
 {
  "page": "P25",
  "id": "p25s3",
  "text": "何をしてほしいか。",
  "file": "p25s3.mp3",
  "duration": 1.358
 },
 {
  "page": "P25",
  "id": "p25s4",
  "text": "2つ目、コンテキスト。",
  "file": "p25s4.mp3",
  "duration": 1.881
 },
 {
  "page": "P25",
  "id": "p25s5",
  "text": "なぜ、誰のためか。",
  "file": "p25s5.mp3",
  "duration": 1.724
 },
 {
  "page": "P25",
  "id": "p25s6",
  "text": "3つ目、期待値。",
  "file": "p25s6.mp3",
  "duration": 1.515
 },
 {
  "page": "P25",
  "id": "p25s7",
  "text": "どんな形式でほしいか。",
  "file": "p25s7.mp3",
  "duration": 1.829
 },
 {
  "page": "P25",
  "id": "p25s8",
  "text": "で、4つ目、ソース。",
  "file": "p25s8.mp3",
  "duration": 2.246
 },
 {
  "page": "P25",
  "id": "p25s9",
  "text": "どの資料を見てほしいか。",
  "file": "p25s9.mp3",
  "duration": 1.593
 },
 {
  "page": "P25",
  "id": "p25s10",
  "text": "この4つを意識するだけで、返ってくる答えの質が別物になります。",
  "file": "p25s10.mp3",
  "duration": 5.46
 },
 {
  "page": "P25",
  "id": "p25s11",
  "text": "これ、めちゃくちゃ大事です。",
  "file": "p25s11.mp3",
  "duration": 1.724
 },
 {
  "page": "P26",
  "id": "p26s0",
  "text": "例えばですね、ダメな例が、いい感じの資料作って。",
  "file": "p26s0.mp3",
  "duration": 4.206
 },
 {
  "page": "P26",
  "id": "p26s1",
  "text": "これだと、いい感じの中身がAIに伝わらないんですよ。",
  "file": "p26s1.mp3",
  "duration": 3.5
 },
 {
  "page": "P26",
  "id": "p26s2",
  "text": "良い例は、新入社員向けに、時間管理研修のアウトラインを、親しみやすいトーンで、箇条書きで作って。",
  "file": "p26s2.mp3",
  "duration": 7.811
 },
 {
  "page": "P26",
  "id": "p26s3",
  "text": "目標、相手、トーン、形式が全部入ってますよね。",
  "file": "p26s3.mp3",
  "duration": 3.866
 },
 {
  "page": "P26",
  "id": "p26s4",
  "text": "呪文はいらないんです。",
  "file": "p26s4.mp3",
  "duration": 1.463
 },
 {
  "page": "P26",
  "id": "p26s5",
  "text": "人に仕事を頼むときと同じ伝え方でいい、ということですね。",
  "file": "p26s5.mp3",
  "duration": 4.284
 },
 {
  "page": "P27",
  "id": "p27s0",
  "text": "で、一発で完璧なものを求めない、というのも大事なコツですね。",
  "file": "p27s0.mp3",
  "duration": 5.538
 },
 {
  "page": "P27",
  "id": "p27s1",
  "text": "返ってきたものに、もっと短く、とか、表にして、とか、別の案もちょうだい、と追加でお願いすればいいんです。",
  "file": "p27s1.mp3",
  "duration": 8.098
 },
 {
  "page": "P27",
  "id": "p27s2",
  "text": "人に頼むときと違って、AIは何回やり直させても嫌な顔ひとつしません。",
  "file": "p27s2.mp3",
  "duration": 5.277
 },
 {
  "page": "P27",
  "id": "p27s3",
  "text": "会話しながら仕上げていく。",
  "file": "p27s3.mp3",
  "duration": 1.724
 },
 {
  "page": "P27",
  "id": "p27s4",
  "text": "この感覚を掴んだ人から、どんどん速くなっていきます。",
  "file": "p27s4.mp3",
  "duration": 3.814
 },
 {
  "page": "P28",
  "id": "p28s0",
  "text": "で、ここからは僕の持論なんですけれども、AIへの頼み方で一番大事なのは、作業を渡すんじゃなくて、仕事ごと渡すことなんですよ。",
  "file": "p28s0.mp3",
  "duration": 9.482
 },
 {
  "page": "P28",
  "id": "p28s1",
  "text": "どういうことかというと、セルをこう直して、と頼むと、指示した分しか返ってこないんです。",
  "file": "p28s1.mp3",
  "duration": 6.243
 },
 {
  "page": "P28",
  "id": "p28s2",
  "text": "でも、この資料を仕上げて、と頼むと、段取りから確認までまとめて返ってくるんですね。",
  "file": "p28s2.mp3",
  "duration": 6.322
 },
 {
  "page": "P28",
  "id": "p28s3",
  "text": "手順を細かく指示するほど、AIは道具のままです。",
  "file": "p28s3.mp3",
  "duration": 3.631
 },
 {
  "page": "P28",
  "id": "p28s4",
  "text": "任せるほど、部下になっていくわけです。",
  "file": "p28s4.mp3",
  "duration": 2.664
 },
 {
  "page": "P28",
  "id": "p28s5",
  "text": "ゴールと条件だけ伝えて、途中のやり方は任せてみてください。",
  "file": "p28s5.mp3",
  "duration": 4.702
 },
 {
  "page": "P29",
  "id": "p29s0",
  "text": "もう一つ、僕がずっと言っているのが、目指すのは○○長のポジションだ、という話です。",
  "file": "p29s0.mp3",
  "duration": 6.374
 },
 {
  "page": "P29",
  "id": "p29s1",
  "text": "雑誌なら、記事を直しているのが編集で、方向を決めるのが編集長じゃないですか。",
  "file": "p29s1.mp3",
  "duration": 5.59
 },
 {
  "page": "P29",
  "id": "p29s2",
  "text": "今のAIの使い方って、多くの人が編集の側にいるんですよ。",
  "file": "p29s2.mp3",
  "duration": 4.624
 },
 {
  "page": "P29",
  "id": "p29s3",
  "text": "指示は出すけど、結局自分が手を動かして仕上げている。",
  "file": "p29s3.mp3",
  "duration": 3.788
 },
 {
  "page": "P29",
  "id": "p29s4",
  "text": "そうじゃなくて、AIを作業者として何人も動かして、自分は判断と方向づけに回る。",
  "file": "p29s4.mp3",
  "duration": 6.53
 },
 {
  "page": "P29",
  "id": "p29s5",
  "text": "ここに回れた瞬間から、仕事の進み方が全然変わります。",
  "file": "p29s5.mp3",
  "duration": 4.65
 },
 {
  "page": "P30",
  "id": "p30s0",
  "text": "で、お願い文を自分で考えるのが大変、という方に朗報なんですけれども、Copilotにはプロンプトギャラリーという、公式のお手本集が用意されているんですよ。",
  "file": "p30s0.mp3",
  "duration": 10.501
 },
 {
  "page": "P30",
  "id": "p30s1",
  "text": "マイクロソフトが作った実用プロンプトがずらっと並んでいて、気に入ったものは保存も、チームへの共有もできちゃいます。",
  "file": "p30s1.mp3",
  "duration": 8.229
 },
 {
  "page": "P30",
  "id": "p30s2",
  "text": "まずはここから真似して、自分用に少し書き換える。",
  "file": "p30s2.mp3",
  "duration": 3.814
 },
 {
  "page": "P30",
  "id": "p30s3",
  "text": "これが一番の近道かなと思います。",
  "file": "p30s3.mp3",
  "duration": 2.299
 },
 {
  "page": "P31",
  "id": "p31s0",
  "text": "ここからは、職種別の活用ですね。",
  "file": "p31s0.mp3",
  "duration": 2.534
 },
 {
  "page": "P31",
  "id": "p31s1",
  "text": "まず営業の方。",
  "file": "p31s1.mp3",
  "duration": 1.175
 },
 {
  "page": "P31",
  "id": "p31s2",
  "text": "商談前に、この会社の最新情報をまとめて、で下調べが数分で終わります。",
  "file": "p31s2.mp3",
  "duration": 5.773
 },
 {
  "page": "P31",
  "id": "p31s3",
  "text": "で、商談後は、会議メモから、お礼メールと次のアクションを作って、と頼めばOKです。",
  "file": "p31s3.mp3",
  "duration": 6.844
 },
 {
  "page": "P31",
  "id": "p31s4",
  "text": "提案書も、過去の資料を参照させて、たたき台を作らせればいいわけですね。",
  "file": "p31s4.mp3",
  "duration": 4.937
 },
 {
  "page": "P31",
  "id": "p31s5",
  "text": "マイクロソフトの調査では、営業担当者は時間の7割を事務作業に取られているそうなので、ここが削れると強いですよね。",
  "file": "p31s5.mp3",
  "duration": 8.229
 },
 {
  "page": "P32",
  "id": "p32s0",
  "text": "次に、経理や事務の方ですね。",
  "file": "p32s0.mp3",
  "duration": 2.482
 },
 {
  "page": "P32",
  "id": "p32s1",
  "text": "毎月の定型業務が、AIと相性抜群なんですよ。",
  "file": "p32s1.mp3",
  "duration": 4.101
 },
 {
  "page": "P32",
  "id": "p32s2",
  "text": "Excelで、先月と今月の差が大きい項目を教えて、とチェックさせたり、未回収リストから督促メールの下書きを作らせたり。",
  "file": "p32s2.mp3",
  "duration": 9.117
 },
 {
  "page": "P32",
  "id": "p32s3",
  "text": "あとは、この手順を新人向けの手順書にまとめて、みたいな使い方も効きますね。",
  "file": "p32s3.mp3",
  "duration": 5.904
 },
 {
  "page": "P32",
  "id": "p32s4",
  "text": "地味だけど、確実に毎月の時間が戻ってくる領域です。",
  "file": "p32s4.mp3",
  "duration": 4.467
 },
 {
  "page": "P33",
  "id": "p33s0",
  "text": "で、企画やマーケティングの方。",
  "file": "p33s0.mp3",
  "duration": 2.769
 },
 {
  "page": "P33",
  "id": "p33s1",
  "text": "市場調査の要約、キャンペーン結果のレポート、企画書のたたき台、このあたりが得意技ですね。",
  "file": "p33s1.mp3",
  "duration": 6.557
 },
 {
  "page": "P33",
  "id": "p33s2",
  "text": "例えば、ターゲット別に訴求メッセージを3案ずつ出して、みたいなアイデア出しの壁打ち相手としても優秀です。",
  "file": "p33s2.mp3",
  "duration": 7.366
 },
 {
  "page": "P33",
  "id": "p33s3",
  "text": "ゼロから考える時間を、選んで磨く時間に変えられるということですね。",
  "file": "p33s3.mp3",
  "duration": 5.042
 },
 {
  "page": "P34",
  "id": "p34s0",
  "text": "あとは、管理職の方ですね。",
  "file": "p34s0.mp3",
  "duration": 2.429
 },
 {
  "page": "P34",
  "id": "p34s1",
  "text": "マイクロソフトが公開している一日のモデルケースだと、朝は溜まったメールをCopilotで大体20分ぐらいで処理して、出られなかった会議は要点だけ把握。",
  "file": "p34s1.mp3",
  "duration": 10.24
 },
 {
  "page": "P34",
  "id": "p34s2",
  "text": "で、部下への返事も、過去のやり取りを要約させてから書く。",
  "file": "p34s2.mp3",
  "duration": 4.023
 },
 {
  "page": "P34",
  "id": "p34s3",
  "text": "読む時間を減らして、判断する時間を増やす。",
  "file": "p34s3.mp3",
  "duration": 3.317
 },
 {
  "page": "P34",
  "id": "p34s4",
  "text": "これが管理職のCopilot活用の本質かなと思います。",
  "file": "p34s4.mp3",
  "duration": 3.866
 },
 {
  "page": "P35",
  "id": "p35s0",
  "text": "で、ここからは数字の話ですね。",
  "file": "p35s0.mp3",
  "duration": 2.377
 },
 {
  "page": "P35",
  "id": "p35s1",
  "text": "マイクロソフトの調査では、Copilot利用者の70%が、生産性が上がったと答えていて、検索や文章作成は29%速くなったんですね。",
  "file": "p35s1.mp3",
  "duration": 10.971
 },
 {
  "page": "P35",
  "id": "p35s2",
  "text": "で、僕が一番すごいと思ったのが、イギリス政府の実証実験ですね。",
  "file": "p35s2.mp3",
  "duration": 4.937
 },
 {
  "page": "P35",
  "id": "p35s3",
  "text": "公務員2万人で試したら、1人あたり1日26分の時間削減。",
  "file": "p35s3.mp3",
  "duration": 4.806
 },
 {
  "page": "P35",
  "id": "p35s4",
  "text": "しかも82%が、もう元の働き方には戻りたくない、と答えたんです。",
  "file": "p35s4.mp3",
  "duration": 6.191
 },
 {
  "page": "P36",
  "id": "p36s0",
  "text": "1日26分って聞くと、大したことないように思うかもしれません。",
  "file": "p36s0.mp3",
  "duration": 4.049
 },
 {
  "page": "P36",
  "id": "p36s1",
  "text": "でもですね、毎日積み重なると、1年で約13営業日分。",
  "file": "p36s1.mp3",
  "duration": 5.904
 },
 {
  "page": "P36",
  "id": "p36s2",
  "text": "ほぼ2週間半の休みが生まれる計算です。",
  "file": "p36s2.mp3",
  "duration": 3.5
 },
 {
  "page": "P36",
  "id": "p36s3",
  "text": "で、大事なのはここからで、浮いた時間を次の改善に使うんですよ。",
  "file": "p36s3.mp3",
  "duration": 4.702
 },
 {
  "page": "P36",
  "id": "p36s4",
  "text": "僕はこれを、時短の複利と呼んでいます。",
  "file": "p36s4.mp3",
  "duration": 2.795
 },
 {
  "page": "P36",
  "id": "p36s5",
  "text": "空いた時間で、また一つ自動化を作ると、さらに時間が空くんですね。",
  "file": "p36s5.mp3",
  "duration": 4.885
 },
 {
  "page": "P36",
  "id": "p36s6",
  "text": "この繰り返しで、最強の個人に近づいていくんじゃないかなと思います。",
  "file": "p36s6.mp3",
  "duration": 4.336
 },
 {
  "page": "P37",
  "id": "p37s0",
  "text": "日本企業でも、結果が出ています。",
  "file": "p37s0.mp3",
  "duration": 2.194
 },
 {
  "page": "P37",
  "id": "p37s1",
  "text": "九州電力グループは、事前の検証で会議や資料作成の時間が最大13.2%減る結果を出して、約1万人に全社導入。",
  "file": "p37s1.mp3",
  "duration": 9.221
 },
 {
  "page": "P37",
  "id": "p37s2",
  "text": "就職情報の学情は、導入3ヶ月で5,004時間、金額にして約1,300万円分のコスト削減を達成したそうです。",
  "file": "p37s2.mp3",
  "duration": 9.038
 },
 {
  "page": "P37",
  "id": "p37s3",
  "text": "日本製鉄も4,400人に展開して、会議のAIメモが1ヶ月で2万件使われたと。",
  "file": "p37s3.mp3",
  "duration": 6.113
 },
 {
  "page": "P37",
  "id": "p37s4",
  "text": "もう、大きい会社では当たり前になりつつあるんですね。",
  "file": "p37s4.mp3",
  "duration": 3.683
 },
 {
  "page": "P38",
  "id": "p38s0",
  "text": "とはいえ、うまくいかない会社もあるんですよ。",
  "file": "p38s0.mp3",
  "duration": 2.717
 },
 {
  "page": "P38",
  "id": "p38s1",
  "text": "よくあるのが、導入したけど何に使えばいいかわからなくて、誰も使わなくなるパターン。",
  "file": "p38s1.mp3",
  "duration": 5.721
 },
 {
  "page": "P38",
  "id": "p38s2",
  "text": "実際、半年後も使い続けている人は4割ほど、という調査もあるんですね。",
  "file": "p38s2.mp3",
  "duration": 5.46
 },
 {
  "page": "P38",
  "id": "p38s3",
  "text": "で、突破のコツはシンプルで、毎日やる作業に食い込ませることなんですよ。",
  "file": "p38s3.mp3",
  "duration": 5.46
 },
 {
  "page": "P38",
  "id": "p38s4",
  "text": "たまにやる特別な仕事じゃなくて、毎朝のメールとか、毎週の報告書とか、どうせやる作業に組み込む。",
  "file": "p38s4.mp3",
  "duration": 8.751
 },
 {
  "page": "P38",
  "id": "p38s5",
  "text": "この本の職種別のページを、自分の月曜の朝に当てはめてみてください。",
  "file": "p38s5.mp3",
  "duration": 4.937
 },
 {
  "page": "P38",
  "id": "p38s6",
  "text": "それだけで景色が変わります。",
  "file": "p38s6.mp3",
  "duration": 1.698
 },
 {
  "page": "P39",
  "id": "p39s0",
  "text": "で、有料版のPremiumだと何が変わるのかというと、組織のデータ、つまり会社のメール、会議、ファイルの中身とつながるんですよ。",
  "file": "p39s0.mp3",
  "duration": 9.404
 },
 {
  "page": "P39",
  "id": "p39s1",
  "text": "例えば、昨日届いたメールを一覧にして、とか、先週の会議の要点をまとめて、みたいなことができちゃう。",
  "file": "p39s1.mp3",
  "duration": 7.811
 },
 {
  "page": "P39",
  "id": "p39s2",
  "text": "ここまで来ると、もう専属の秘書が一人ついた感じですね。",
  "file": "p39s2.mp3",
  "duration": 4.388
 },
 {
  "page": "P39",
  "id": "p39s3",
  "text": "あとは、混み合っている時でも優先的に処理してもらえる、優先アクセスというのもついてきますね。",
  "file": "p39s3.mp3",
  "duration": 5.877
 },
 {
  "page": "P40",
  "id": "p40s0",
  "text": "で、2026年のいま、Copilotはさらに、エージェントというAI社員の方向に進化しています。",
  "file": "p40s0.mp3",
  "duration": 7.366
 },
 {
  "page": "P40",
  "id": "p40s1",
  "text": "Work IQという頭脳が、皆さんのメールや会議、仕事のクセまで理解して、次にやるべきことを先回りで提案してくれるんですよ。",
  "file": "p40s1.mp3",
  "duration": 8.803
 },
 {
  "page": "P40",
  "id": "p40s2",
  "text": "資料を作っておいて、と頼んだら、勝手に進めておいてくれる世界が、もう始まっているんですね。",
  "file": "p40s2.mp3",
  "duration": 7.262
 },
 {
  "page": "P40",
  "id": "p40s3",
  "text": "だからこそ、今のうちに基本を押さえておくのが大事なんです。",
  "file": "p40s3.mp3",
  "duration": 3.631
 },
 {
  "page": "P41",
  "id": "p41s0",
  "text": "最後に、上達のコツを3つだけお伝えします。",
  "file": "p41s0.mp3",
  "duration": 3.37
 },
 {
  "page": "P41",
  "id": "p41s1",
  "text": "1つ目、お願いは具体的に。",
  "file": "p41s1.mp3",
  "duration": 2.351
 },
 {
  "page": "P41",
  "id": "p41s2",
  "text": "目標、文脈、形式を伝えること。",
  "file": "p41s2.mp3",
  "duration": 3.265
 },
 {
  "page": "P41",
  "id": "p41s3",
  "text": "2つ目、一発で完璧を求めない。",
  "file": "p41s3.mp3",
  "duration": 3.213
 },
 {
  "page": "P41",
  "id": "p41s4",
  "text": "追いお願いで仕上げればいいんです。",
  "file": "p41s4.mp3",
  "duration": 1.698
 },
 {
  "page": "P41",
  "id": "p41s5",
  "text": "で、3つ目、まずは毎日1回使ってみる。",
  "file": "p41s5.mp3",
  "duration": 3.97
 },
 {
  "page": "P41",
  "id": "p41s6",
  "text": "これだけで、1ヶ月後には手放せなくなってるんじゃないかなと思います。",
  "file": "p41s6.mp3",
  "duration": 4.206
 },
 {
  "page": "P42",
  "id": "p42s0",
  "text": "で、明日からの最初の一週間、これだけやってみてください。",
  "file": "p42s0.mp3",
  "duration": 4.023
 },
 {
  "page": "P42",
  "id": "p42s1",
  "text": "1日目、Copilotを開いてみる。",
  "file": "p42s1.mp3",
  "duration": 2.246
 },
 {
  "page": "P42",
  "id": "p42s2",
  "text": "2日目、何か1つ質問する。",
  "file": "p42s2.mp3",
  "duration": 3.03
 },
 {
  "page": "P42",
  "id": "p42s3",
  "text": "3日目、メールを1本下書きさせる。",
  "file": "p42s3.mp3",
  "duration": 3.082
 },
 {
  "page": "P42",
  "id": "p42s4",
  "text": "4日目、Excelの表を分析させる。",
  "file": "p42s4.mp3",
  "duration": 3.5
 },
 {
  "page": "P42",
  "id": "p42s5",
  "text": "5日目、長い文書を要約させる。",
  "file": "p42s5.mp3",
  "duration": 2.664
 },
 {
  "page": "P42",
  "id": "p42s6",
  "text": "6日目、資料のたたき台を作らせる。",
  "file": "p42s6.mp3",
  "duration": 3.187
 },
 {
  "page": "P42",
  "id": "p42s7",
  "text": "で、7日目、浮いた時間で何をするか考える。",
  "file": "p42s7.mp3",
  "duration": 3.187
 },
 {
  "page": "P42",
  "id": "p42s8",
  "text": "ここまでできたら、皆さんはもう、社内のAI先進派ですよ。",
  "file": "p42s8.mp3",
  "duration": 4.388
 },
 {
  "page": "P43",
  "id": "p43s0",
  "text": "はいということで、Microsoft Copilot入門、完全版、以上になります。",
  "file": "p43s0.mp3",
  "duration": 4.989
 },
 {
  "page": "P43",
  "id": "p43s1",
  "text": "ここまで聴いてくださって、ありがとうございました。",
  "file": "p43s1.mp3",
  "duration": 2.194
 },
 {
  "page": "P43",
  "id": "p43s2",
  "text": "まずは明日、会社のパソコンでCopilotを開いてみるところから始めていただけたらなと思います。",
  "file": "p43s2.mp3",
  "duration": 6.609
 },
 {
  "page": "P43",
  "id": "p43s3",
  "text": "で、僕のYouTubeチャンネル、メンタエクセルでは、ExcelやAIで最強の個人になるための情報を発信していますので、そちらもぜひチェックしてみてください。",
  "file": "p43s3.mp3",
  "duration": 9.535
 },
 {
  "page": "P43",
  "id": "p43s4",
  "text": "それでは、一緒にスキルアップしていきましょう。",
  "file": "p43s4.mp3",
  "duration": 2.351
 },
 {
  "page": "P43",
  "id": "p43s5",
  "text": "お疲れ様でした。",
  "file": "p43s5.mp3",
  "duration": 1.097
 }
]